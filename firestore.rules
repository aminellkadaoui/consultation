rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing application rules retained.
    match /elite_responses/{id} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }
    match /client_context/{id} {
      allow create: if true;
      allow update: if request.auth != null
                    || request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['booking_status','bookingOpenedAt','bookingConfirmedAt']);
      allow read, delete: if request.auth != null;
    }

    // BEGIN CONSULTATION RULES
    function isConsultationAdmin() {
      return request.auth != null
        && request.auth.uid in ['9ZN6AKrcdgYg6cVeQKOzgZGGQfl1'];
    }

    function consultationText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validTrackingToken(token) {
      return consultationText(token, 32, 128)
        && token.matches('^[A-Za-z0-9_-]+$');
    }

    function validProgressStatus(status) {
      return status in ['completed', 'current', 'pending'];
    }

    function validProgressStage(stage, key) {
      return stage is map
        && stage.keys().hasAll(['key', 'status'])
        && stage.keys().hasOnly(['key', 'status'])
        && stage.key == key
        && validProgressStatus(stage.status);
    }

    function validProgressStages(stages) {
      return stages is list
        && stages.size() == 4
        && validProgressStage(stages[0], 'submitted')
        && validProgressStage(stages[1], 'booking_payment')
        && validProgressStage(stages[2], 'meeting')
        && validProgressStage(stages[3], 'action_plan');
    }

    function validCurrentStage(stage) {
      return stage in ['submitted', 'booking_payment', 'meeting', 'action_plan'];
    }

    function consultationRequestFieldsV1() {
      return [
        'fullName', 'whatsapp', 'instagram', 'experience', 'clientCount', 'editingType',
        'problem', 'impact', 'goal', 'approach', 'obstacle', 'sessionOutcome',
        'status', 'schemaVersion', 'submittedAt'
      ];
    }

    function validConsultationRequestV1(d) {
      return d.keys().hasAll(consultationRequestFieldsV1())
        && d.keys().hasOnly(consultationRequestFieldsV1())
        && consultationText(d.fullName, 1, 120)
        && consultationText(d.whatsapp, 1, 32)
        && consultationText(d.instagram, 1, 80)
        && consultationText(d.experience, 1, 80)
        && consultationText(d.clientCount, 1, 40)
        && consultationText(d.editingType, 1, 200)
        && consultationText(d.problem, 1, 2000)
        && consultationText(d.impact, 1, 2000)
        && consultationText(d.goal, 1, 2000)
        && consultationText(d.approach, 1, 2000)
        && consultationText(d.obstacle, 1, 2000)
        && consultationText(d.sessionOutcome, 1, 2000)
        && d.status == 'new'
        && d.schemaVersion is int && d.schemaVersion == 1
        && d.submittedAt is timestamp && d.submittedAt == request.time;
    }

    function consultationArrayItem(items, index) {
      return items.size() <= index || consultationText(items[index], 1, 200);
    }

    function validConsultationRequestV2(d) {
      let fields = ['fullName', 'whatsapp', 'instagram', 'experience', 'clientCount', 'editingType',
        'problem', 'lastSituation', 'goal', 'approach', 'obstacle', 'sessionOutcome',
        'status', 'schemaVersion', 'submittedAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && consultationText(d.fullName, 1, 120)
        && consultationText(d.whatsapp, 1, 32)
        && consultationText(d.instagram, 1, 80)
        && consultationText(d.experience, 1, 80)
        && consultationText(d.clientCount, 1, 40)
        && d.editingType is list && d.editingType.size() >= 1 && d.editingType.size() <= 7
        && consultationArrayItem(d.editingType, 0) && consultationArrayItem(d.editingType, 1)
        && consultationArrayItem(d.editingType, 2) && consultationArrayItem(d.editingType, 3)
        && consultationArrayItem(d.editingType, 4) && consultationArrayItem(d.editingType, 5)
        && consultationArrayItem(d.editingType, 6)
        && consultationText(d.problem, 1, 2000)
        && consultationText(d.lastSituation, 1, 2000)
        && consultationText(d.goal, 1, 2000)
        && consultationText(d.approach, 1, 2000)
        && consultationText(d.obstacle, 1, 2000)
        && consultationText(d.sessionOutcome, 1, 2000)
        && d.status == 'new' && d.schemaVersion is int && d.schemaVersion == 2
        && d.submittedAt is timestamp && d.submittedAt == request.time;
    }

    function validConsultationRequestV3(d) {
      let fields = ['fullName', 'whatsapp', 'instagram', 'experience', 'clientCount', 'editingType',
        'problem', 'lastSituation', 'goal', 'approach', 'obstacle', 'sessionOutcome',
        'status', 'schemaVersion', 'trackingToken', 'currentStage', 'stages', 'submittedAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && consultationText(d.fullName, 1, 120)
        && consultationText(d.whatsapp, 1, 32)
        && consultationText(d.instagram, 1, 80)
        && consultationText(d.experience, 1, 80)
        && consultationText(d.clientCount, 1, 40)
        && d.editingType is list && d.editingType.size() >= 1 && d.editingType.size() <= 7
        && consultationArrayItem(d.editingType, 0) && consultationArrayItem(d.editingType, 1)
        && consultationArrayItem(d.editingType, 2) && consultationArrayItem(d.editingType, 3)
        && consultationArrayItem(d.editingType, 4) && consultationArrayItem(d.editingType, 5)
        && consultationArrayItem(d.editingType, 6)
        && consultationText(d.problem, 1, 2000)
        && consultationText(d.lastSituation, 1, 2000)
        && consultationText(d.goal, 1, 2000)
        && consultationText(d.approach, 1, 2000)
        && consultationText(d.obstacle, 1, 2000)
        && consultationText(d.sessionOutcome, 1, 2000)
        && d.status == 'new'
        && d.schemaVersion is int && d.schemaVersion == 3
        && validTrackingToken(d.trackingToken)
        && validCurrentStage(d.currentStage)
        && validProgressStages(d.stages)
        && d.submittedAt is timestamp && d.submittedAt == request.time;
    }

    function validConsultationRequest(d) {
      return ('schemaVersion' in d) && (
        (d.schemaVersion == 1 && validConsultationRequestV1(d))
        || (d.schemaVersion == 2 && validConsultationRequestV2(d))
        || (d.schemaVersion == 3 && validConsultationRequestV3(d))
      );
    }

    function validConsultationStatus(status) {
      return status in ['new', 'reviewing', 'accepted', 'scheduled', 'completed', 'archived'];
    }

    match /consultation_requests/{requestId} {
      allow create: if validConsultationRequest(request.resource.data);
      allow get, list: if isConsultationAdmin();
      allow update: if isConsultationAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'privateNotes', 'stages', 'currentStage', 'trackingToken', 'updatedAt'])
        && validConsultationStatus(request.resource.data.status)
        && (!('privateNotes' in request.resource.data)
          || consultationText(request.resource.data.privateNotes, 0, 6000))
        && (!('stages' in request.resource.data) || validProgressStages(request.resource.data.stages))
        && (!('currentStage' in request.resource.data) || validCurrentStage(request.resource.data.currentStage))
        && (!('trackingToken' in request.resource.data) || validTrackingToken(request.resource.data.trackingToken))
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validProgressDocument(d, token) {
      let fields = ['stages', 'currentStage', 'updatedAt'];
      return validTrackingToken(token)
        && d.keys().hasAll(fields)
        && d.keys().hasOnly(fields)
        && validProgressStages(d.stages)
        && validCurrentStage(d.currentStage)
        && d.updatedAt is timestamp
        && d.updatedAt == request.time;
    }

    match /consultation_progress/{token} {
      allow get: if validTrackingToken(token);
      allow list: if false;
      allow create: if validProgressDocument(request.resource.data, token);
      allow update: if isConsultationAdmin()
        && validProgressDocument(request.resource.data, token);
      allow delete: if false;
    }

    function validNotificationDevice(d) {
      let fields = ['token', 'ownerUid', 'enabled', 'userAgent', 'createdAt', 'lastSeenAt', 'updatedAt'];
      return d.keys().hasAll(fields)
        && d.keys().hasOnly(fields)
        && consultationText(d.token, 20, 4096)
        && consultationText(d.ownerUid, 1, 128)
        && d.ownerUid == request.auth.uid
        && d.enabled is bool
        && consultationText(d.userAgent, 0, 500)
        && d.createdAt is timestamp
        && d.lastSeenAt is timestamp && d.lastSeenAt == request.time
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }

    match /consultation_notification_devices/{deviceId} {
      allow get, list: if isConsultationAdmin();
      allow create: if isConsultationAdmin()
        && deviceId.matches('^[a-f0-9]{64}$')
        && validNotificationDevice(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isConsultationAdmin()
        && deviceId.matches('^[a-f0-9]{64}$')
        && validNotificationDevice(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.token == resource.data.token;
      allow delete: if isConsultationAdmin();
    }

    match /consultation_notification_tests/{testId} {
      allow create: if isConsultationAdmin()
        && request.resource.data.keys().hasAll(['uid', 'token', 'requestedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'token', 'requestedAt'])
        && request.resource.data.uid == request.auth.uid
        && consultationText(request.resource.data.token, 20, 4096)
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.requestedAt == request.time;
      allow get, list, update, delete: if false;
    }

    // Delivery/idempotency and test-rate documents are server-only.
    match /consultation_email_deliveries/{id} {
      allow read, write: if false;
    }
    match /consultation_push_deliveries/{id} {
      allow read, write: if false;
    }
    match /consultation_notification_test_limits/{id} {
      allow read, write: if false;
    }

    function validConsultationTestimonialAt(items, i) {
      return items.size() <= i || (
        items[i] is map
        && items[i].keys().hasAll(['name', 'role', 'quote', 'videoUrl', 'imageUrl'])
        && items[i].keys().hasOnly(['name', 'role', 'quote', 'videoUrl', 'imageUrl'])
        && consultationText(items[i].name, 1, 120)
        && consultationText(items[i].role, 0, 200)
        && consultationText(items[i].quote, 0, 3000)
        && consultationText(items[i].videoUrl, 0, 2048)
        && consultationText(items[i].imageUrl, 0, 2048)
        && (items[i].videoUrl == '' || items[i].videoUrl.matches('https://[^ ]+'))
        && (items[i].imageUrl == '' || items[i].imageUrl.matches('https://[^ ]+'))
        && (items[i].quote.size() > 0 || items[i].videoUrl.size() > 0 || items[i].imageUrl.size() > 0)
      );
    }

    function validConsultationSettings(d) {
      let fields = [
        'brand', 'headline', 'subheadline', 'price', 'currency', 'durationMinutes',
        'actionDocHours', 'videoUrl', 'videoPoster', 'bookingUrl', 'contactWhatsapp',
        'testimonials', 'updatedAt'
      ];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && consultationText(d.brand, 1, 120)
        && consultationText(d.headline, 1, 240)
        && consultationText(d.subheadline, 1, 1000)
        && consultationText(d.currency, 1, 12)
        && consultationText(d.videoUrl, 0, 2048)
        && consultationText(d.videoPoster, 0, 2048)
        && consultationText(d.bookingUrl, 0, 2048)
        && consultationText(d.contactWhatsapp, 0, 64)
        && (d.price is int || d.price is float) && d.price >= 0 && d.price <= 100000
        && d.durationMinutes is int && d.durationMinutes >= 1 && d.durationMinutes <= 480
        && d.actionDocHours is int && d.actionDocHours >= 1 && d.actionDocHours <= 168
        && d.testimonials is list && d.testimonials.size() <= 12
        && validConsultationTestimonialAt(d.testimonials, 0)
        && validConsultationTestimonialAt(d.testimonials, 1)
        && validConsultationTestimonialAt(d.testimonials, 2)
        && validConsultationTestimonialAt(d.testimonials, 3)
        && validConsultationTestimonialAt(d.testimonials, 4)
        && validConsultationTestimonialAt(d.testimonials, 5)
        && validConsultationTestimonialAt(d.testimonials, 6)
        && validConsultationTestimonialAt(d.testimonials, 7)
        && validConsultationTestimonialAt(d.testimonials, 8)
        && validConsultationTestimonialAt(d.testimonials, 9)
        && validConsultationTestimonialAt(d.testimonials, 10)
        && validConsultationTestimonialAt(d.testimonials, 11)
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }

    match /consultation_settings/{settingsId} {
      allow get: if settingsId == 'public';
      allow list: if false;
      allow create, update: if settingsId == 'public' && isConsultationAdmin()
        && validConsultationSettings(request.resource.data);
      allow delete: if false;
    }
    // END CONSULTATION RULES
  }
}
